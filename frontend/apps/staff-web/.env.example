# Copy to .env.local (git-ignored) and adjust. Values are baked in at build time.

# Origin of the MediLink API, no trailing slash (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# true = answer API calls with the MSW mocks of the Sprint 0 contract (no backend needed).
# `pnpm dev:mock` / `pnpm build:mock` force it on.
VITE_USE_MOCKS=false

# Origin of the public patient site, for "view your public page" links (default: http://localhost:5174)
VITE_PATIENT_WEB_URL=http://localhost:5174

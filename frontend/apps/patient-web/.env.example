# Copy to .env.local (git-ignored) and adjust. Values are baked in at build time.

# Origin of the MediLink API, no trailing slash (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# true = answer API calls with the MSW mocks of the Sprint 0 contract (no backend needed).
# `pnpm dev:mock` / `pnpm build:mock` force it on. The PWA service worker is not registered
# in mock mode (MSW uses its own service worker).
VITE_USE_MOCKS=false

# Map tile URL template for the home and Find care maps (upgrade 03 §2). The provider for Rwanda
# is open decision OD-3; the OpenStreetMap default is for development only.
# VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# true = the AI symptom assistant on the public pages (/assistant and the floating button).
# Off by default: it runs on a test model (public site audit 2026-11-07). Signed-in patients
# keep it in the dashboard either way.
# VITE_PUBLIC_ASSISTANT=false
# Public address of the site, for canonical links and Open Graph (no trailing slash).
# VITE_SITE_URL=https://medilink.rw

{
  "name": "@medilink/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript, ESLint, Prettier and Vite configuration for the MediLink frontend.",
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.react.json": "./tsconfig.react.json",
    "./eslint": "./eslint.js",
    "./prettier": "./prettier.js",
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    }
  },
  "scripts": {
    "typecheck": "node --check eslint.js && node --check prettier.js && node --check vite.js && node --check eslint-rules/no-literal-jsx-text.js"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "peerDependencies": {
    "eslint": "^9.39.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "vite": "catalog:"
  }
}

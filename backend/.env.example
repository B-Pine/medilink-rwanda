# MediLink API configuration. Copy to backend/.env for local development:  cp .env.example .env
# Values below match docker-compose.yml (local, non-secret defaults). Never commit a real .env.
# Production gets these from the key store / deployment environment, never from a file in git.

# --- Django ----------------------------------------------------------------------------------
# config.settings.dev | config.settings.test | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
# Set to false to ignore backend/.env entirely (CI, containers). Must be a real env var to work.
# DJANGO_READ_DOT_ENV=true
# Required in production (dev has an insecure default): 50+ random characters (python -c "import secrets; print(secrets.token_urlsafe(64))")
# DJANGO_SECRET_KEY=
# Comma-separated previous keys, for zero-downtime rotation
# DJANGO_SECRET_KEY_FALLBACKS=
# Comma-separated host names served by this API (production: api.medilink.rw)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL 17) ----------------------------------------------------------------
# Runtime role: NOSUPERUSER NOBYPASSRLS, owns no tables (row-level security applies)
DATABASE_URL=postgres://medilink_app:medilink_app_dev_only@127.0.0.1:5433/medilink
# Owner role, used only by `manage.py migrate` (and by the test runner to create test databases)
DATABASE_OWNER_URL=postgres://medilink_owner:medilink_owner_dev_only@127.0.0.1:5433/medilink
# Name of the runtime role that receives table privileges after each migrate
DATABASE_APP_ROLE=medilink_app
# Persistent connections in seconds (prod default 60)
DATABASE_CONN_MAX_AGE=0
# Statement timeout for web requests in ms (prod default 5000; 0 = off)
DATABASE_STATEMENT_TIMEOUT_MS=0
# Internal: set to "owner" by manage.py for schema commands. Leave unset.
# MEDILINK_DB_ROLE=

# --- Redis: cache, channel layer, Celery broker ----------------------------------------------
CACHE_URL=redis://127.0.0.1:6379/1
CHANNEL_LAYER_URL=redis://127.0.0.1:6379/2
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Run tasks inline instead of in a worker (dev default true; must be false in production)
CELERY_TASK_ALWAYS_EAGER=true

# --- Email -----------------------------------------------------------------------------------
# Dev: Mailpit (UI at http://localhost:8025). Prod example: smtp+tls://user:password@smtp.example.rw:587
EMAIL_URL=smtp://127.0.0.1:1025
DEFAULT_FROM_EMAIL=MediLink Rwanda <no-reply@medilink.test>

# --- Frontends (separately hosted, ADR 0006) -------------------------------------------------
# Comma-separated exact origins; no wildcards. Production: https://staff.medilink.rw,https://medilink.rw
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Defaults to CORS_ALLOWED_ORIGINS
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174
# Allowed WebSocket origins; defaults to CORS_ALLOWED_ORIGINS
WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Used to build links in emails (password reset)
STAFF_APP_URL=http://localhost:5173
PATIENT_APP_URL=http://localhost:5174

# --- Cookies and sessions --------------------------------------------------------------------
# Names default to __Host-ml_staff / __Host-ml_patient / __Host-ml_admin / __Host-ml_csrf in
# production and to ml_staff / ml_patient / ml_admin / ml_csrf in dev (plain http).
# STAFF_SESSION_COOKIE_NAME=
# PATIENT_SESSION_COOKIE_NAME=
# ADMIN_SESSION_COOKIE_NAME=
# CSRF_COOKIE_NAME=
# Timeouts in seconds (security 03 §5)
STAFF_SESSION_IDLE_TIMEOUT=900
STAFF_SESSION_ABSOLUTE_TIMEOUT=43200
PATIENT_SESSION_IDLE_TIMEOUT=43200
PATIENT_SESSION_ABSOLUTE_TIMEOUT=2592000

# --- Security --------------------------------------------------------------------------------
# Number of trusted reverse proxies in front of the app (X-Forwarded-For). Prod behind one proxy: 1
NUM_PROXIES=0
# Rate limits (DRF format: N/sec|min|hour|day). IP limits are deliberately high.
THROTTLE_RATE_BURST=600/min
THROTTLE_RATE_AUTH=60/min
THROTTLE_RATE_MFA=30/min
THROTTLE_RATE_REGISTER=20/hour
THROTTLE_RATE_PASSWORD_RESET=10/hour
# Optional offline breached-password list: path to a file of SHA-1 hashes (HIBP format ok)
# PASSWORD_BREACHED_HASHES_FILE=
# Issuer shown in authenticator apps
MFA_TOTP_ISSUER=MediLink Rwanda
# Development only (requires DEBUG): staff log in without the authenticator step, for local testing.
# Refused outside DEBUG (medilink.E003) and by `check --deploy` (medilink.E004). Never set in staging or production.
# DEV_SKIP_STAFF_MFA=false

# --- Tools -----------------------------------------------------------------------------------
# Django admin (OTP-protected, platform admins only). Dev default on, prod default off.
ADMIN_ENABLED=true
ADMIN_URL=ops-admin/
# OpenAPI schema at /api/v1/schema/ (+ Swagger UI in dev). Prod default off.
SCHEMA_ENABLED=true

# --- Logging ---------------------------------------------------------------------------------
LOG_LEVEL=INFO
# json | text (dev default text)
LOG_FORMAT=text

# ---- Sprint settings: each sprint documents its variables ONLY between its markers ----
# [S1]
# [/S1]
# [S3]
# [/S3]
# [S9]
# [/S9]

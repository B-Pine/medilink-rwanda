{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": [
      "/bin/sh -c \"python scripts/railway_bootstrap_db.py && MEDILINK_DB_ROLE=owner python manage.py migrate --noinput\""
    ],
    "startCommand": "/bin/sh -c \"exec uvicorn config.asgi:application --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --no-server-header --workers 2\"",
    "healthcheckPath": "/api/v1/health/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}

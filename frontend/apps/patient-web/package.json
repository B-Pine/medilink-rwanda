{
  "name": "@medilink/patient-web",
  "version": "0.1.0",
  "private": true,
  "description": "MediLink patient web app (PWA) and public pages. Static site.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build && node ../../scripts/check-pwa.mjs dist",
    "build:mock": "vite build --mode mock && node ../../scripts/check-pwa.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@medilink/api-client": "workspace:*",
    "@medilink/ui": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@medilink/config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "catalog:",
    "workbox-build": "catalog:",
    "workbox-window": "catalog:"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

{
  "name": "@medilink/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the MediLink API (/api/v1) and MSW mocks of the sprint contracts.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./mocks": "./src/mocks/index.ts",
    "./mocks/node": "./src/mocks/node.ts",
    "./mocks/browser": "./src/mocks/browser.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate-types": "node scripts/generate-types.mjs"
  },
  "peerDependencies": {
    "msw": "^2.15.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@medilink/config": "workspace:*",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "openapi-typescript": "^7.13.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
